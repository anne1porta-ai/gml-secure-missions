# Copiez ce fichier vers .env OU utilisez scripts/create-local-env.*
# Ne jamais versionner les vraies valeurs de secrets.
JWT_SECRET=<secret-HMAC-aleatoire-32-octets-minimum>
ENCRYPTION_KEY=<cle-AES-256-de-32-octets-encodee-en-Base64>
DB_PASSWORD=<mot-de-passe-postgresql-local-ou-prod>

# PostgreSQL en lancement backend direct / environnement personnalisé
DB_URL=jdbc:postgresql://localhost:5432/gmlshield
DB_USER=gml

DEMO_SEED_ENABLED=false

# Compte administrateur initial, créé au premier démarrage si aucun administrateur n'existe
# (12 caractères minimum). Ces deux lignes peuvent être retirées ensuite.
ADMIN_EMAIL=<email-administrateur>
ADMIN_PASSWORD=<mot-de-passe-administrateur>
COOKIE_SECURE=true
FRONTEND_ORIGIN=https://application.example
DOCUMENT_STORAGE_PATH=./storage/documents

# Durcissement authentification (adapter à la politique réelle)
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION_SECONDS=300
AUTH_MAX_TRACKED_IDENTITIES=10000
AUTH_IP_RATE_LIMIT_MAX_REQUESTS=20
AUTH_IP_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_IP_RATE_LIMIT_MAX_CLIENTS=10000


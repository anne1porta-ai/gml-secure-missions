<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
        DOMPurify 3.4.13 est embarqué dans Swagger UI (webjar fourni par springdoc).
        Le correctif amont (DOMPurify 3.4.17) n'est pas encore publié dans une version
        de Swagger UI. Swagger UI n'est pas exposé en production : nginx ne relaie que /api/.
        Exception temporaire : à son échéance, la CI échoue de nouveau si la dépendance
        n'a pas été mise à jour. Suivi : TD-16 (docs/TECHNICAL_DEBT_REGISTER.md).
    -->
    <suppress until="2026-12-31Z">
        <notes>DOMPurify embarqué dans Swagger UI, non exposé en production ; en attente d'une version corrigée de Swagger UI.</notes>
        <packageUrl regex="true">^pkg:javascript/DOMPurify@3\.4\.13$</packageUrl>
        <cve>CVE-2026-116802</cve>
        <cve>CVE-2026-116803</cve>
        <cve>CVE-2026-116804</cve>
        <cve>CVE-2026-109344</cve>
        <cve>CVE-2026-109345</cve>
    </suppress>
</suppressions>

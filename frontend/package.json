{
  "name": "gml-shield-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "npx --yes eslint@10.10.0 .",
    "lint:fix": "npx --yes eslint@10.10.0 . --fix",
    "format:check": "npx --yes prettier@3.9.6 --check src test vite.config.js",
    "format:write": "npx --yes prettier@3.9.6 --write src test vite.config.js",
    "quality": "npm run lint && npm run format:check && npm test && npm run build",
    "test": "node --test"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.1"
  }
}

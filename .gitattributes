# Fins de ligne normalisées : le dépôt stocke du LF, quel que soit le poste.
# Sans cela, un script .sh enregistré depuis Windows (CRLF) échoue sous Linux.
* text=auto eol=lf

# Scripts propres à Windows : CRLF conservé.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Fichiers binaires : jamais convertis.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.jar binary
